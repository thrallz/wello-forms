<%# Wello Forms: send / re-send the signing link by SMS through the account's Twilio settings %>
<% unless turbo_native_app? %>
  <div class="mt-2 mb-1">
    <% if Wello::Sms.configured?(current_account) %>
      <%= button_to button_title(title: submitter.sent_at? ? t('re_send_sms') : t('send_sms'), disabled_with: t('sending')), wello_submitter_sms_path(submitter), class: 'btn btn-sm btn-primary w-full' %>
    <% elsif can?(:manage, EncryptedConfig.new(account: current_account)) %>
      <%= link_to t('wello_set_up_sms'), settings_sms_path, class: 'btn btn-sm btn-ghost w-full' %>
    <% end %>
  </div>
<% end %>
