<div class="flex flex-wrap space-y-4 md:flex-nowrap md:space-y-0">
  <%= render 'shared/settings_nav' %>
  <div class="flex-grow max-w-xl mx-auto min-w-0">
    <h1 class="text-3xl md:text-4xl font-bold mb-2">Vtiger</h1>
    <p class="mb-6 opacity-70"><%= t('wello_vtiger_settings_description') %></p>
    <% value = @encrypted_config.value.is_a?(Hash) ? @encrypted_config.value : {} %>
    <% if Wello::Vtiger.configured?(current_account) %>
      <div class="alert mb-4">
        <%= svg_icon('circle_check', class: 'w-6 h-6 text-accent') %>
        <span><%= t('wello_vtiger_connected') %></span>
      </div>
    <% end %>
    <%= form_for @encrypted_config, url: settings_wello_vtiger_path, method: :post, html: { autocomplete: 'off', class: 'space-y-4' } do |f| %>
      <%= f.fields_for :value do |ff| %>
        <div class="form-control">
          <%= ff.label :url, t('wello_vtiger_url'), class: 'label' %>
          <%= ff.text_field :url, value: value['url'], required: true, class: 'base-input', placeholder: 'https://yourcompany.od2.vtiger.com' %>
        </div>
        <div class="grid md:grid-cols-2 gap-4">
          <div class="form-control">
            <%= ff.label :username, t('wello_vtiger_username'), class: 'label' %>
            <%= ff.text_field :username, value: value['username'], required: true, class: 'base-input' %>
          </div>
          <div class="form-control">
            <%= ff.label :access_key, t('wello_vtiger_access_key'), class: 'label' %>
            <%= ff.password_field :access_key, class: 'base-input', required: value['access_key'].blank?, placeholder: value['access_key'].present? ? '*************' : '' %>
          </div>
        </div>
        <p class="text-xs opacity-60"><%= t('wello_vtiger_access_key_hint') %></p>
        <div class="form-control">
          <%= ff.label :signature_module, "#{t('wello_vtiger_signature_module')} (#{t('optional')})", class: 'label' %>
          <%= ff.text_field :signature_module, value: value['signature_module'], class: 'base-input', placeholder: t('wello_vtiger_signature_module_placeholder') %>
        </div>
        <div class="form-control">
          <%= ff.label :mid_field, "#{t('wello_vtiger_mid_field')} (#{t('optional')})", class: 'label' %>
          <%= ff.text_field :mid_field, value: value['mid_field'], class: 'base-input', placeholder: 'cf_accounts_mid' %>
        </div>
      <% end %>
      <div class="form-control pt-2">
        <%= f.button button_title(title: t('wello_save_and_test'), disabled_with: t('saving')), class: 'base-button' %>
      </div>
    <% end %>
    <% if @encrypted_config.persisted? %>
      <div class="mt-4 text-center">
        <%= button_to t('wello_disconnect'), settings_wello_vtiger_path, method: :delete, class: 'link text-sm opacity-70', form: { data: { turbo_confirm: t('are_you_sure_') } } %>
      </div>
    <% end %>

    <% if @signatures_check %>
      <div class="mt-8 rounded-2xl border border-base-300 p-5 space-y-3">
        <h2 class="text-xl font-bold"><%= t('wello_vtiger_signatures_check') %></h2>
        <% if @signatures_check[:error] %>
          <p class="text-sm text-error"><%= @signatures_check[:error] %></p>
        <% elsif @signatures_check[:module_name].blank? %>
          <p class="text-sm opacity-80"><%= t('wello_vtiger_signatures_not_found') %></p>
        <% else %>
          <p class="text-sm"><%= t('wello_vtiger_signatures_found', name: @signatures_check[:module_name]) %></p>
          <% map = @signatures_check[:map] %>
          <ul class="text-sm space-y-1">
            <% Wello::VtigerSignatures::FIELD_LABELS.each_key do |key| %>
              <li class="flex items-center gap-2">
                <%= svg_icon(map[key] ? 'circle_check' : 'x', class: "w-4 h-4 #{map[key] ? 'text-accent' : 'text-error'}") %>
                <span><%= t("wello_vtiger_field_#{key}") %></span>
                <% if map[key] %><span class="opacity-50 font-mono text-xs"><%= map[key] %></span><% end %>
              </li>
            <% end %>
            <% %w[Accounts Contacts Leads Potentials].each do |target| %>
              <li class="flex items-center gap-2">
                <%= svg_icon(map[:references][target] ? 'circle_check' : 'x', class: "w-4 h-4 #{map[:references][target] ? 'text-accent' : 'opacity-40'}") %>
                <span><%= t('wello_vtiger_related_to', module: t("wello_vtiger_module_#{target.downcase}")) %></span>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    <% end %>

    <% open_url = wello_vtiger_open_url(**Docuseal.default_url_options) %>
    <div class="mt-10 space-y-3">
      <h2 class="text-xl font-bold"><%= t('wello_vtiger_link_title') %></h2>
      <p class="text-sm opacity-80"><%= t('wello_vtiger_link_steps') %></p>
      <ol class="list-decimal pl-5 text-sm space-y-1 opacity-80">
        <li><%= t('wello_vtiger_link_step1') %></li>
        <li><%= t('wello_vtiger_link_step2') %></li>
        <li><%= t('wello_vtiger_link_step3') %></li>
      </ol>
      <% { 'Accounts' => 'account_no', 'Contacts' => 'contact_no', 'Leads' => 'lead_no', 'Potentials' => 'potential_no' }.each do |module_name, field| %>
        <div>
          <div class="text-xs font-semibold mb-1"><%= t("wello_vtiger_module_#{module_name.downcase}", default: module_name) %></div>
          <pre class="bg-base-200 rounded-xl p-3 text-xs overflow-x-auto whitespace-pre-wrap select-all">concat('<%= open_url %>?module=<%= module_name %>&number=', <%= field %>)</pre>
        </div>
      <% end %>
      <p class="text-xs opacity-60"><%= t('wello_vtiger_link_existing_records') %></p>
    </div>

    <div class="mt-10 space-y-3">
      <h2 class="text-xl font-bold"><%= t('wello_vtiger_button_title') %></h2>
      <p class="text-sm opacity-80"><%= t('wello_vtiger_button_steps') %></p>
      <pre class="bg-base-200 rounded-xl p-4 text-xs overflow-x-auto whitespace-pre-wrap select-all">window.open('<%= open_url %>?module=' + VTAP.Detail.Module() + '&record=' + VTAP.Detail.Id(), '_blank');</pre>
      <p class="text-xs opacity-60"><%= t('wello_vtiger_button_modules') %></p>
    </div>
  </div>
  <div class="w-0 lg:w-52"></div>
</div>
