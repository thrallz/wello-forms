<% roles = [
     ['admin', t('admin'), 'Full access: settings, users, every document'],
     ['manager', t('wello_role_manager', default: 'Manager'), "Own team's templates and documents"],
     ['employee', t('wello_role_employee', default: 'Employee'), 'Sends any template; sees only own documents'],
     ['client', t('wello_role_client', default: 'Client'), 'Client portal only: documents sent to their email']
   ] %>
<div class="form-control">
  <%= f.label :role, class: 'label' %>
  <%= f.select :role, roles.map { |value, label, _| [label, value] }, {}, class: 'base-select' %>
  <ul class="text-xs mt-2 mx-1 space-y-0.5 opacity-70">
    <% roles.each do |_, label, description| %>
      <li><span class="font-semibold"><%= label %>:</span> <%= description %></li>
    <% end %>
  </ul>
</div>
<% teams = current_account ? WelloTeam.where(account: current_account).ordered : WelloTeam.none %>
<div class="form-control">
  <%= f.label :wello_team_id, t('wello_team', default: 'Team'), class: 'label' %>
  <%= f.select :wello_team_id, teams.map { |team| [team.name, team.id] }, { include_blank: t('wello_no_team', default: 'No team') }, class: 'base-select' %>
  <% if teams.empty? %>
    <span class="label-text-alt mt-2 mx-1">
      <%= link_to t('wello_create_teams_in_settings', default: 'Create teams in Settings → Teams'), settings_wello_teams_path, class: 'link', data: { turbo_frame: :_top } %>
    </span>
  <% end %>
</div>
